<?xml version="1.0" encoding="utf-8"?>
<configuration
  xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <!--
    Web.config transform for Debug builds.
    Uses LocalDB for development.
  -->
  <connectionStrings>
    <add name="CommerceDb"
      connectionString="Data Source=(LocalDb)\MSSQLLocalDB;Initial Catalog=ContosoCommerce_Dev;Integrated Security=True;MultipleActiveResultSets=True"
      providerName="System.Data.SqlClient"
      xdt:Transform="SetAttributes"
      xdt:Locator="Match(name)" />
  </connectionStrings>
  <system.web>
    <compilation
      xdt:Transform="RemoveAttributes(debug)" />
  </system.web>
</configuration>
