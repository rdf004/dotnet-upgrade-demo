{
  "ConnectionStrings": {
    "CommerceDb": "Data Source=(LocalDb)\\MSSQLLocalDB;Initial Catalog=ContosoCommerce;Integrated Security=True;MultipleActiveResultSets=True"
  },
  "PaymentSettings": {
    "GatewayUrl": "https://pay.contoso.com/api"
  },
  "SmtpSettings": {
    "Host": "localhost",
    "Port": 25
  },
  "InventorySettings": {
    "LowStockThreshold": 10
  },
  "StockMonitor": {
    "Threshold": 10,
    "IntervalMinutes": 30
  },
  "ReportSettings": {
    "CacheMinutes": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" }
    ]
  }
}
