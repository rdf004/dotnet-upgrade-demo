<?xml version="1.0" encoding="utf-8"?>
<configuration
  xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <!--
    Web.config transform for Release builds.
    Uses SQL Server with a proper connection.
  -->
  <connectionStrings>
    <add name="CommerceDb"
      connectionString="Server=sql.contoso.com;Database=ContosoCommerce;User Id=app_user;Password=REPLACE_IN_DEPLOY;MultipleActiveResultSets=True"
      providerName="System.Data.SqlClient"
      xdt:Transform="SetAttributes"
      xdt:Locator="Match(name)" />
  </connectionStrings>
  <appSettings>
    <add key="PaymentGatewayUrl"
      value="https://pay.contoso.com/api/v2"
      xdt:Transform="SetAttributes"
      xdt:Locator="Match(key)" />
    <add key="SmtpHost"
      value="smtp-prod.contoso.com"
      xdt:Transform="SetAttributes"
      xdt:Locator="Match(key)" />
  </appSettings>
  <system.web>
    <compilation
      xdt:Transform="RemoveAttributes(debug)" />
  </system.web>
</configuration>
